
<!DOCTYPE html>
<html>
<head>
    <title>My First Website</title>

    <style>
        body {
            background-color: #fff8dc;
            font-family: Arial;
            padding: 20px;
        }

        h1 {
            color: green;
            text-align: center;
        }

        h2 {
            color: darkblue;
        }

        p {
            color: #333333;
            font-size: 18px;
        }

        button {
            background-color: red;
            color: white;
            padding: 12px;
            border: none;
            border-radius: 8px;
        }
    </style>
</head>

<body>

    <h1>Welcome to My Website</h1>

    <h2>My Name is Aman</h2>

